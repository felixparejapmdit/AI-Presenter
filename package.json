{
  "name": "vanguard-deck",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "AI-powered VIP client presentation assistant built on Tauri v2, React 19 and local Ollama vision models.",
  "scripts": {
    "icons": "node scripts/generate-icons.mjs",
    "predev:web": "node scripts/generate-icons.mjs && node scripts/check-port.mjs 17391",
    "dev:web": "vite --port 17391 --strictPort --host 127.0.0.1",
    "dev": "tauri dev",
    "start": "tauri dev",
    "prebuild:web": "node scripts/generate-icons.mjs",
    "build:web": "tsc --noEmit && vite build",
    "preview:web": "vite preview --port 17392 --strictPort --host 127.0.0.1",
    "build": "tauri build",
    "build:exe": "tauri build --no-bundle",
    "typecheck": "tsc --noEmit",
    "check:spec": "node scripts/check-spec.mjs",
    "test:unit": "vitest run",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:e2e": "playwright test --project=web",
    "test:e2e:tauri": "playwright test --project=tauri",
    "test:e2e:live": "playwright test --project=live",
    "test": "npm run check:spec && npm run test:unit && npm run build:web && npm run test:e2e",
    "mock:ollama": "node scripts/mock-ollama.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@iconify/react": "^6.0.4",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-clipboard-manager": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "@tauri-apps/plugin-os": "^2.4.0",
    "@tauri-apps/plugin-shell": "^2.6.0",
    "@tauri-apps/plugin-sql": "^2.6.0",
    "clsx": "^2.1.1",
    "html-to-image": "^1.11.13",
    "jspdf": "^4.2.1",
    "pptxgenjs": "^4.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.150",
    "@iconify-json/tabler": "^1.2.43",
    "@iconify/utils": "^3.1.7",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.4",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "jszip": "^3.10.2",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
